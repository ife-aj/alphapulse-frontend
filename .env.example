# AlphaPulse frontend environment.
#
# Copy this file to `.env` and adjust if your backend is not on the default
# host/port. `.env` is git-ignored — never commit real values, and never put
# backend secrets (a Supabase service-role key, a database URL) in this file:
# every VITE_-prefixed variable is inlined into the browser bundle and is
# readable by anyone who loads the app.

# Base URL of the AlphaPulse API, without a trailing slash.
#
# Local development: /api uses Vite's proxy.
# Netlify: set https://YOUR-BACKEND.onrender.com/api and rebuild.
VITE_API_BASE_URL=/api

# Where the dev/preview server forwards /api requests.
# Server-side only: no VITE_ prefix, so it never reaches the browser bundle.
API_PROXY_TARGET=http://localhost:3000
